# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=            # optional; empty => rules-only explanations
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=800
AI_MAX_INPUT_CHARS=6000
DNS_ENABLED=true
SCAN_FETCH_ENABLED=false      # live page fetch off by default
ENABLE_MOCK_INTEL=true        # labelled MOCK provider for demos only
RISK_SUSPICIOUS_THRESHOLD=30
RISK_PHISHING_THRESHOLD=65
RATE_LIMIT_PER_MINUTE=10
